# Plantilla de configuración de nginx para servir los assets estáticos de
# `front` (ver docs/architecture.md, sección "Despliegue"). `__GATEWAY_ORIGIN__`
# se sustituye en tiempo de BUILD de la imagen (Dockerfile), no en runtime —
# debe ser el mismo valor que `VITE_GATEWAY_BASE_URL`, ya horneado en el
# bundle JS por Vite, para que la CSP no bloquee las propias llamadas de
# `src/api` (docs/security-scope.md: nunca se añade un dominio de terceros
# sin aprobación explícita, y `connect-src` se restringe al dominio del
# Gateway configurado en build, no a cualquier origen).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Restrictiva a propósito: sin script/estilo/imagen de terceros, sin
    # `unsafe-inline` (el código no usa estilos/scripts inline), y
    # `connect-src` limitado exactamente al Gateway — `front` nunca llama a
    # otro origen (docs/architecture.md: "front solo habla con el Gateway").
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src __GATEWAY_ORIGIN__; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        # SPA: cualquier ruta que no matchee un archivo real cae a
        # index.html (previendo la capa de routing de `src/routes`, aún sin
        # introducir — ver docs/architecture.md). Inocuo hoy: no hay rutas
        # anidadas todavía.
        try_files $uri /index.html;
    }
}
